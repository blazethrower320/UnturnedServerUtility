<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:UnturnedServerUtility.ViewModels;assembly=UnturnedServerUtility"
        xmlns:styles="clr-namespace:UnturnedServerUtility.GUI.Styles;assembly=UnturnedServerUtility"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="UnturnedServerUtility.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="UnturnedServerUtility"
        RequestedThemeVariant="Dark">

    <!-- Design Time Data Context for Avalonia Previewer -->
    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.DataTemplates>
        <DataTemplate DataType="vm:ServerSelectionViewModel">
            <styles:ServerSelection/>
        </DataTemplate>
        <DataTemplate DataType="vm:ServerConsoleViewModel">
            <styles:ServerConsole/>
        </DataTemplate>
        <DataTemplate DataType="vm:ServerFilesViewModel">
            <styles:ServerFiles/>
        </DataTemplate>
        <DataTemplate DataType="vm:FileEditorViewModel">
            <styles:FileEditor/>
        </DataTemplate>
    </Window.DataTemplates>

    <Border Background="#18191A" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Top Header -->
            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" 
                    Background="#202225" 
                    Height="40" 
                    HorizontalAlignment="Stretch">
                <TextBlock 
                    VerticalAlignment="Center" 
                    Margin="8,0" 
                    Foreground="White" 
                    FontSize="20" 
                    FontWeight="Bold">Unturned Server Utility</TextBlock>
            </Border>

            <!-- Sidebar Navigation -->
            <Border Grid.Row="1" Grid.Column="0" Background="#242526" Width="150">
                <DockPanel LastChildFill="False" HorizontalAlignment="Stretch" Margin="0, 10, 0, 0">
                    <DockPanel.Styles>
                        <StyleInclude Source="avares://UnturnedServerUtility/GUI/Styles/SidebarButtonStyle.axaml"/>
                    </DockPanel.Styles>

                    <Button Classes="SidebarBtn" Click="Sidebar_Dashboard_Click" Content="Dashboard" HorizontalAlignment="Stretch" DockPanel.Dock="Top" Margin="5"/>
                    <Button Classes="SidebarBtn" Click="Sidebar_Servers_Click" Content="Servers" HorizontalAlignment="Stretch" DockPanel.Dock="Top" Margin="5"/>
                    <Button Classes="SidebarBtn" Click="Sidebar_Settings_Click" Content="Settings" HorizontalAlignment="Stretch" DockPanel.Dock="Top" Margin="5"/>
                </DockPanel>
            </Border>

            <!-- Dynamic View Host -->
            <TransitioningContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentView}" />
        </Grid>
    </Border>
</Window>