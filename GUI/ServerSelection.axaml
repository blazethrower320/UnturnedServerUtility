<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:UnturnedServerUtility.Models"
             xmlns:viewmodels="using:UnturnedServerUtility.ViewModels"
             mc:Ignorable="d" d:DesignWidth="650" d:DesignHeight="410"
             x:Class="UnturnedServerUtility.GUI.Styles.ServerSelection"
             x:DataType="viewmodels:ServerSelectionViewModel">
    <Border Background="#18191A">
        <Grid RowDefinitions="Auto, *">
        <!-- Top Toolbar Actions -->
        <Border Grid.Row="0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,10,0" Spacing="10">
                <Button>Create Server</Button>
                <Button>Delete</Button>
            </StackPanel>
        </Border>

		<!-- Main Server Content Area -->
		<Grid Grid.Row="1" Margin="10">
			<ItemsControl ItemsSource="{Binding ServerList}">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="models:ServerCollection">
						<Border Background="#202225" 
                            CornerRadius="6" 
                            Padding="12,8" 
                            Margin="0,4">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.Styles>
                                    <Style Selector="Button">
                                        <Setter Property="Padding" Value="10,4"/>
                                        <Setter Property="Margin" Value="3,0"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="CornerRadius" Value="4"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Style>
                                </Grid.Styles>
                                <TextBlock Text="{Binding severName}" 
                                           Foreground="White" 
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           VerticalAlignment="Center" 
                                           Grid.Column="0" />

                                <Border Grid.Column="1" 
                                        Background="#2F3136" 
                                        CornerRadius="4" 
                                        Padding="8,4" 
                                        Margin="0,0,12,0" 
                                        VerticalAlignment="Center">
                                    <TextBlock Foreground="#B9BBBE" FontSize="12" FontWeight="Medium">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}/{1} Players">
                                                <Binding Path="playerCount" />
                                                <Binding Path="playerMax" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Border>
                                <Button Grid.Column="2" Background="#43B581">Start</Button>
                                <Button Grid.Column="3" Background="#FAA61A">Stop</Button>
                                <Button Grid.Column="4" Background="#F04747">Kill</Button>
                            </Grid>
                        </Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</Grid>
    </Grid>
    </Border>
</UserControl>