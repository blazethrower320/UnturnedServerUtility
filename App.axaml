<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UnturnedServerUtility.ViewModels;assembly=UnturnedServerUtility"
             xmlns:views="clr-namespace:UnturnedServerUtility.GUI.Styles;assembly=UnturnedServerUtility"
             x:Class="UnturnedServerUtility.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <DataTemplate DataType="{x:Type vm:ServerSelectionViewModel}">
            <views:ServerSelection />
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>